  echo "timer: $(systemctl is-active box-cleanup.timer 2>/dev/null || true) / $(systemctl is-enabled box-cleanup.timer 2>/dev/null || true)"
  systemctl list-timers box-cleanup.timer --no-pager 2>/dev/null | sed -n '2p' || true
  journalctl -u box-cleanup.service -n 8 --no-pager -o cat 2>/dev/null || true
}
r_set_cleanup_mode() {
  case "${1:-}" in report|stop|destroy) ;; *) die "bad mode '${1:-}'";; esac
  [ -x /usr/local/sbin/box-host ] || die "cleanup helper not installed; run: box cleanup install"
  printf '%s\n' "$1" >/etc/box/cleanup.mode
