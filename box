fn=$1; shift
"r_$fn" "$@"
REMOTE_EOF

# ---------------------------------------------------------------- plumbing
mkdir -p "$STATE_DIR" && chmod 700 "$STATE_DIR"
# One pinned identity for both addresses of the Proxmox host (HostKeyAlias): a key learned on the LAN
# address must match over Tailscale and vice versa, and a changed key is refused, never silently accepted.
SSH_PVE=(-o BatchMode=yes -o "ConnectTimeout=$CONNECT_TIMEOUT" -o ServerAliveInterval=10 -o ServerAliveCountMax=3
  -o HostKeyAlias=box-pve -o "UserKnownHostsFile=$STATE_DIR/known_hosts_pve" -o StrictHostKeyChecking=accept-new
  -o ControlMaster=auto -o "ControlPath=$STATE_DIR/cm-%C" -o ControlPersist=60)

PVE_ACTIVE=""
host_of() { local h=${1#*@}; h=${h#\[}; printf '%s' "${h%%\]*}"; }
file_age() { local m; m=$(stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null) || return 1; echo $(( $(date +%s) - m )); }
# A control connection to an address that just went away can hang a probe for ~30s (until keepalives
# give up). Bound the probe, and when it fails drop the stale master so the next attempt starts clean.
pve_probe() {
  local rc=0 to=$((CONNECT_TIMEOUT + 3))
  if command -v timeout >/dev/null 2>&1; then
    timeout "$to" ssh -n "${SSH_PVE[@]}" "$1" true >/dev/null 2>&1 || rc=$?
  else
    ssh -n "${SSH_PVE[@]}" "$1" true >/dev/null 2>&1 || rc=$?
  fi
  [ "$rc" -eq 0 ] || ssh -O exit "${SSH_PVE[@]}" "$1" >/dev/null 2>&1 || true
  return "$rc"
}

# route_try: pick the address to use, LAN (PVE_HOST) first. After a fallback the alternate is tried first
# for 30s so every command does not pay a connect timeout, then LAN is probed again and wins when back.
# Sets PVE_ACTIVE and records it in $STATE_DIR/route. Returns 1 when nothing answers.
route_try() {
  local order=("$PVE_HOST") last="" age
  [ -n "$PVE_HOST" ] || return 1
  [ -z "$PVE_HOST_ALT" ] || order+=("$PVE_HOST_ALT")
  if [ -n "$PVE_HOST_ALT" ] && [ -s "$STATE_DIR/route" ]; then
    last=$(cat "$STATE_DIR/route"); age=$(file_age "$STATE_DIR/route" || echo 999)
    if [ "$last" = "$PVE_HOST_ALT" ] && [ "$age" -lt 30 ]; then order=("$PVE_HOST_ALT" "$PVE_HOST"); fi
  fi
  local h
  for h in "${order[@]}"; do
    if pve_probe "$h"; then
      PVE_ACTIVE=$h
      if [ "$h" != "$last" ] && [ -n "$last" ]; then
        if [ "$h" = "$PVE_HOST" ]; then log "route: back on LAN ($h)"; else log "route: LAN unreachable, using alternate ($h)"; fi
      fi
      printf '%s' "$h" >"$STATE_DIR/route"
      return 0
    fi
  done
  return 1
}
route() {
  [ -z "$PVE_ACTIVE" ] || return 0
  [ -n "$PVE_HOST" ] || die "not configured; run: box init --host root@<pve-ip>"
  route_try || die "cannot reach Proxmox at $PVE_HOST${PVE_HOST_ALT:+ or $PVE_HOST_ALT} (is the network or Tailscale up? try: box doctor)"
}
need_host() { route; }

# True when both addresses present at least one identical host key (they are the same machine).
same_host_key() {
  local a b
  a=$(ssh-keyscan -T 5 "$(host_of "$1")" 2>/dev/null | awk '$1 !~ /^#/ && NF>=3{print $2" "$3}' | sort -u)
  b=$(ssh-keyscan -T 5 "$(host_of "$2")" 2>/dev/null | awk '$1 !~ /^#/ && NF>=3{print $2" "$3}' | sort -u)
  [ -n "$a" ] && [ -n "$b" ] && [ -n "$(comm -12 <(printf '%s\n' "$a") <(printf '%s\n' "$b"))" ]
}

remote_env() {
  local v
  for v in GOLDEN_CTID ID_MIN ID_MAX STORAGE BRIDGE TEMPLATE_VOLID FULL_CLONE MAX_RUNNING MIN_FREE_MB MIN_SWAP_FREE_MB MAX_STORAGE_PCT BOX_FORCE; do
    printf '%s=%q\n' "$v" "${!v}"
  done
  printf 'LEASE_RENEW=%q\nMAX_LIFETIME_S=%q\nGRACE_S=%q\nDESTROY_AFTER_S=%q\n' \
    "$IDLE_RENEW" "$(ttl_seconds "$MAX_LIFETIME")" "$(ttl_seconds "$GRACE")" "$(ttl_seconds "$DESTROY_AFTER")"
}

# rcall <fn> [args...]: run r_<fn> on the PVE host. stdout = result, stderr = progress.
rcall() {
  need_host
  local script
  script="$(remote_env)"$'\n'"$REMOTE_LIB"
  ssh -n "${SSH_PVE[@]}" "$PVE_ACTIVE" "bash -c $(printf '%q' "$script") box-remote $(printf '%q ' "$@")"
}
# rcall_in: like rcall but forwards stdin (used to ship the host helper).
rcall_in() {
  need_host
  local script
  script="$(remote_env)"$'\n'"$REMOTE_LIB"
  ssh "${SSH_PVE[@]}" "$PVE_ACTIVE" "bash -c $(printf '%q' "$script") box-remote $(printf '%q ' "$@")"
}

# pve <cmd...>: run a command on the PVE host with arguments preserved.
pve() { need_host; ssh "${SSH_PVE[@]}" "$PVE_ACTIVE" "$(printf '%q ' "$@")"; }

# ct_ssh_opts <id>: options for ssh/scp/rsync to a box through the PVE host, using the active route.
# The jump hop reuses the pinned host key and keepalives; the box key follows the CT id, not its DHCP address.
CT_OPTS=()
ct_ssh_opts() {
  local id=$1 jump="$STATE_DIR/jump.sh"
  printf '#!/bin/sh\nexec ssh -o BatchMode=yes -o ConnectTimeout="$BOX_CONNECT_TIMEOUT" -o ServerAliveInterval=10 -o ServerAliveCountMax=3 -o HostKeyAlias=box-pve -o UserKnownHostsFile="$BOX_STATE/known_hosts_pve" -o StrictHostKeyChecking=accept-new -o ControlMaster=auto -o ControlPath="$BOX_STATE/cm-%%C" -o ControlPersist=60 -W "$1:$2" "$BOX_JUMP_HOST"\n' >"$jump.new"
  chmod 700 "$jump.new"; mv -f "$jump.new" "$jump"
  export BOX_JUMP_HOST=$PVE_ACTIVE BOX_STATE=$STATE_DIR BOX_CONNECT_TIMEOUT=$CONNECT_TIMEOUT
  CT_OPTS=(-o "ProxyCommand=$jump %h %p" -i "$SSH_KEY" -o "UserKnownHostsFile=$(known_hosts "$id")"
    -o "HostKeyAlias=box-$id" -o StrictHostKeyChecking=accept-new -o "ConnectTimeout=$CONNECT_TIMEOUT"
    -o ServerAliveInterval=10 -o ServerAliveCountMax=3)
}

ttl_seconds() {
  [[ $1 =~ ^([0-9]+)([smhd]?)$ ]] || die "bad ttl '$1' (use e.g. 90s 30m 2h 1d)"
  local n=${BASH_REMATCH[1]} u=${BASH_REMATCH[2]:-s}
  case "$u" in s) echo "$n";; m) echo $((n*60));; h) echo $((n*3600));; d) echo $((n*86400));; esac
}

resolve_id() {
  local a=${1:-current}
  if [ "$a" = current ]; then
    [ -s "$STATE_DIR/current" ] || die "no current box; run 'box new' or pass an id"
    a=$(cat "$STATE_DIR/current")
  fi
  [[ $a =~ ^[0-9]+$ ]] || die "bad id '$a'"
  echo "$a"
}

known_hosts() { echo "$STATE_DIR/known_hosts_$1"; }

