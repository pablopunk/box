# read-only environment report for 'box init'
r_check() {
  echo "pve: $(pveversion 2>/dev/null | head -1)"
  echo "mem: $(free -m | awk '/^Mem:/{print "avail=" $7 "MB total=" $2 "MB"}') $(free -m | awk '/^Swap:/{print "swap_used=" $3 "/" $2 "MB"}')"
  echo "storage:"; pvesm status --storage "$STORAGE" | sed 's/^/  /' || echo "  !! storage $STORAGE not found"
  if pvesm path "$TEMPLATE_VOLID" >/dev/null 2>&1; then echo "template: ok ($TEMPLATE_VOLID)"; else echo "template: MISSING ($TEMPLATE_VOLID)"; fi
  if ip link show "$BRIDGE" >/dev/null 2>&1; then echo "bridge: ok ($BRIDGE)"; else echo "bridge: MISSING ($BRIDGE)"; fi
  if [ -f "$(conf_of "$GOLDEN_CTID")" ]; then
    if grep -q '^template: 1' <<<"$(top_conf "$GOLDEN_CTID")"; then echo "golden: ok (CT $GOLDEN_CTID template)"; else echo "golden: CT $GOLDEN_CTID exists but is NOT a template"; fi
  else echo "golden: absent -> run 'box golden build'"; fi
  local f id foreign=""
  for f in "$PVE_ETC"/nodes/*/lxc/*.conf "$PVE_ETC"/nodes/*/qemu-server/*.conf; do
    [ -e "$f" ] || continue; id=${f##*/}; id=${id%.conf}
    if [ "$id" -ge "$ID_MIN" ] && [ "$id" -le "$ID_MAX" ] && ! is_box "$id"; then foreign="$foreign $id"; fi
  done
  [ -z "$foreign" ] && echo "id range $ID_MIN-$ID_MAX: clear" || echo "id range $ID_MIN-$ID_MAX: IN USE by non-box guests:$foreign (pick another range)"
  echo "all-guest backup jobs (box IDs get appended to 'exclude'):"
  pvesh get /cluster/backup --output-format json | perl -MJSON::PP -e '
    local $/; my $j = JSON::PP::decode_json(<STDIN>);
    for my $x (@$j) { next unless $x->{all}; printf("  %s enabled=%s exclude=%s\n", $x->{id}, ($x->{enabled} // 1), ($x->{exclude} // "")); }'
}

# Verify that no box (and not the golden) can end up in a backup. One line per check:
# "ok", "warn" or "FAIL". Exits 1 on FAIL. With fix=1, add every box id to the all-guest jobs first.
# PVE ignores backup=0 on a container's rootfs (it is always backed up), so job exclusion is the guard.
r_doctor() {
  local fix=${1:-0} id mp out bad=0
  if [ "$fix" = 1 ]; then
    for id in "$GOLDEN_CTID" $(list_ids); do backup_exclude add "$id"; done
  fi
  out=$(pvesh get /cluster/backup --output-format json | perl -MJSON::PP -e '
    local $/; my $jobs = JSON::PP::decode_json(<STDIN>);
    my ($min, $max, $golden, @ids) = @ARGV; my %box = map { $_ => 1 } ($golden, @ids);
    for my $j (@$jobs) {
      next if defined $j->{enabled} && !$j->{enabled};
      if ($j->{all}) {
        my %ex = map { $_ => 1 } grep { length } split(/,/, ($j->{exclude} // ""));
        my @missing = grep { !$ex{$_} } sort { $a <=> $b } keys %box;
        print @missing ? "FAIL\tjob $j->{id} backs up all guests and does not exclude: @missing\n"
                       : "ok\tjob $j->{id} backs up all guests and excludes every box\n";
      } elsif (defined $j->{vmid} && length $j->{vmid}) {
        my @hit = grep { $box{$_} || ($_ >= $min && $_ <= $max) } split(/,/, $j->{vmid});
        print @hit ? "FAIL\tjob $j->{id} lists box ids: @hit\n" : "ok\tjob $j->{id} lists no box ids\n";
      } elsif (defined $j->{pool} && length $j->{pool}) {
        print "warn\tjob $j->{id} backs up pool $j->{pool}: keep box CTs out of that pool\n";
      }
    }' "$ID_MIN" "$ID_MAX" "$GOLDEN_CTID" $(list_ids)) || die "cannot read backup jobs"
  [ -n "$out" ] || out="ok	no enabled backup jobs"
  printf '%s\n' "$out"
  for id in $(list_ids); do
    mp=$(top_conf "$id" | grep -E '^mp[0-9]+:' | grep -v 'backup=0' || true)
    if [ -n "$mp" ]; then echo "FAIL	CT $id has a volume mount point without backup=0: $mp"; bad=1; fi
  done
  echo "info	rootfs is always part of a container backup (PVE ignores backup=0 on it); the job exclusions above are the guard"
  grep -q '^FAIL' <<<"$out" && bad=1
  [ "$bad" = 0 ] || exit 1
}

# Host-side health for 'box doctor'. One "ok|warn|FAIL<TAB>message" per line.
r_hostcheck() {
  local c id mode legacy=0 notmux=""
  for c in pct pvesh pvesm perl flock systemctl; do
    if command -v "$c" >/dev/null 2>&1; then echo "ok	host command: $c"; else echo "FAIL	host command missing: $c"; fi
  done
  if pvesm status --storage "$STORAGE" >/dev/null 2>&1; then echo "ok	storage $STORAGE"; else echo "FAIL	storage $STORAGE not found"; fi
  if ip link show "$BRIDGE" >/dev/null 2>&1; then echo "ok	bridge $BRIDGE"; else echo "FAIL	bridge $BRIDGE missing"; fi
  if r_guard_golden; then echo "ok	golden CT $GOLDEN_CTID is a template"; else echo "FAIL	golden CT $GOLDEN_CTID missing or not a template (box golden build)"; fi
  if [ -x /usr/local/sbin/box-host ] && systemctl is-active --quiet box-cleanup.timer 2>/dev/null; then
    mode=$(cat /etc/box/cleanup.mode 2>/dev/null || echo '?')
    echo "ok	cleanup timer active, mode=$mode"
    [ "$mode" != report ] || echo "warn	cleanup is report-only: expired boxes are listed, never stopped (box cleanup mode stop|destroy)"
  else echo "warn	cleanup timer not installed: expired boxes stay until 'box gc' (box cleanup install)"; fi
  for id in $(list_ids); do
    if [ -z "$(desc_field "$id" ttl)" ] || ! registered "$id"; then legacy=$((legacy+1)); fi
    if [ "$(status_of "$id")" = running ] && ! pct exec "$id" -- sh -c 'command -v tmux >/dev/null' </dev/null >/dev/null 2>&1; then notmux="$notmux $id"; fi
  done
  [ "$legacy" = 0 ] && echo "ok	every box has a lease and a registry entry" \
    || echo "warn	$legacy box(es) predate leases: cleanup skips them until 'box adopt all'"
  [ -z "$notmux" ] && echo "ok	tmux present in every running box" \
    || echo "warn	no tmux in running box(es):$notmux ('box ssh' installs it on demand, or rebuild the golden)"
}

r_guard_golden() {
  [ -f "$(conf_of "$GOLDEN_CTID")" ] || return 1
  grep -q '^template: 1' <<<"$(top_conf "$GOLDEN_CTID")"
}

# Download the LXC template via pveam when 'box init' finds it missing.
r_ensure_template() {
  local tpl=$1 stor file
  pvesm path "$tpl" >/dev/null 2>&1 && { echo "template present: $tpl"; return 0; }
  stor=${tpl%%:*}; file=${tpl##*/}
  { [ "$stor" != "$tpl" ] && [ "$file" != "$tpl" ]; } || die "cannot parse template volid '$tpl' (want STOR:vztmpl/FILE)"
  log "downloading $file into $stor (pveam update + download; slow, one time)..."
  pveam update >&2
  pveam download "$stor" "$file" >&2
  pvesm path "$tpl" >/dev/null || die "download finished but $tpl still missing"
  echo "template ready: $tpl"
}

r_golden_build() {
  local pub=$1 tpl=$2 force=${3:-0} keyf prov
  if [ -e "$(conf_of "$GOLDEN_CTID")" ]; then
    [ "$force" = 1 ] || die "CT $GOLDEN_CTID already exists; rebuild with 'box golden build --force' (or another GOLDEN_CTID)"
    grep -q '^tags: .*boxgolden' <<<"$(top_conf "$GOLDEN_CTID")" || die "CT $GOLDEN_CTID is not a box golden (missing 'boxgolden' tag); refusing to destroy"
    log "rebuilding golden: destroying CT $GOLDEN_CTID (PVE refuses if boxes still reference it)"
    pct stop "$GOLDEN_CTID" >/dev/null 2>&1 || true
    pct destroy "$GOLDEN_CTID" --purge --destroy-unreferenced-disks 1 >&2
    backup_exclude remove "$GOLDEN_CTID" || true
