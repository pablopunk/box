#!/usr/bin/env bash
# box - ephemeral LXC sandboxes on Proxmox, driven over SSH.
# Needs only: bash, ssh locally; pct/pvesh/pvesm/perl on the PVE host.
set -euo pipefail

CONFIG_FILE="${BOX_CONFIG:-$HOME/.config/box/config}"
STATE_DIR="${BOX_STATE:-$HOME/.box}"

# ---------------------------------------------------------------- config
default_key() {
  local k
  for k in "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_ecdsa" "$HOME/.ssh/id_rsa"; do
    [ -f "$k" ] && { printf '%s' "$k"; return 0; }
  done
  printf '%s' "$HOME/.ssh/id_ed25519"
}
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"
: "${PVE_HOST:=}"
: "${PVE_HOST_ALT:=}"          # optional second address of the same host (e.g. root@100.x.y.z over Tailscale)
: "${SSH_KEY:=$(default_key)}"
: "${TEMPLATE_VOLID:=local:vztmpl/debian-13-standard_13.6-1_amd64.tar.zst}"
: "${STORAGE:=local-lvm}"
: "${BRIDGE:=vmbr0}"
: "${GOLDEN_CTID:=9100}"
: "${ID_MIN:=9101}"
: "${ID_MAX:=9199}"
: "${FULL_CLONE:=0}"
: "${DEFAULT_CORES:=1}"
: "${DEFAULT_MEM:=1024}"
: "${DEFAULT_DISK:=8}"
: "${DEFAULT_TTL:=1h}"
: "${MAX_RUNNING:=6}"
: "${MIN_FREE_MB:=1536}"
: "${MIN_SWAP_FREE_MB:=1024}"
: "${MAX_STORAGE_PCT:=85}"
: "${OWNER:=${USER:-box}}"
: "${BOX_FORCE:=0}"
: "${CONNECT_TIMEOUT:=5}"       # seconds to wait per Proxmox address before trying the other one
: "${IDLE_RENEW:=1}"            # 1 = box commands and attached sessions renew a managed box's lease
: "${MAX_LIFETIME:=7d}"         # activity never renews a lease past created + MAX_LIFETIME
: "${GRACE:=10m}"               # host cleanup waits this long past expiry (short disconnects)
: "${DESTROY_AFTER:=24h}"       # host cleanup destroys a stopped box this long after expiry
: "${RECONNECT_TRIES:=40}"      # 'box ssh' reconnect attempts after a lost connection (2s apart)

die() { echo "box: $*" >&2; exit 1; }
log() { echo "box: $*" >&2; }

# ---------------------------------------------------------------- remote library
# Runs on the PVE host as: bash -c "<env + this + dispatch>" box-remote <fn> <args...>
read -r -d '' REMOTE_LIB <<'REMOTE_EOF' || true
set -Eeuo pipefail
die() { echo "box: $*" >&2; exit 1; }
log() { echo "box: $*" >&2; }
now() { date +%s; }
PVE_ETC=${PVE_ETC:-/etc/pve}; LOCK_DIR=${LOCK_DIR:-/run/lock}; BOX_VAR=${BOX_VAR:-/var/lib/box}
: "${MAX_LIFETIME_S:=604800}" "${GRACE_S:=600}" "${DESTROY_AFTER_S:=86400}"
conf_of() { echo "$PVE_ETC/lxc/$1.conf"; }
top_conf() { sed '/^\[/,$d' "$(conf_of "$1")"; }

# Per-container lifecycle lock (fd 8). Every operation that stops, starts, renews or destroys a box
# holds it, so cleanup can never act on a box that a client is resuming or renewing at that moment.
# lock_id <id> <wait-seconds>   (0 = do not wait)
lock_id() {
  mkdir -p "$LOCK_DIR"
  exec 8>"$LOCK_DIR/box-ct-$1.lock"
  if [ "${2:-60}" = 0 ]; then flock -n 8; else flock -w "${2:-60}" 8; fi
}
unlock_id() { exec 8>&-; }

is_box() {
  [[ ${1:-} =~ ^[0-9]+$ ]] || return 1
  [ "$1" -ge "$ID_MIN" ] && [ "$1" -le "$ID_MAX" ] && [ -f "$(conf_of "$1")" ] || return 1
  grep -Eq '^tags: (.*;)?box(;.*)?$' <<<"$(top_conf "$1")"
}
guard() {
  [[ ${1:-} =~ ^[0-9]+$ ]] || die "bad id: ${1:-}"
  is_box "$1" || die "CT $1 is not box-managed (need id $ID_MIN-$ID_MAX and tag 'box'); refusing"
}
list_ids() {
  local f id
  for f in "$PVE_ETC"/lxc/*.conf; do
    [ -e "$f" ] || continue
    id=${f##*/}; id=${id%.conf}
    if is_box "$id"; then echo "$id"; fi
  done
  return 0
}
status_of() { pct status "$1" | awk '{print $2}'; }

# Registry: a host-side record written when box creates (or adopts) a CT. Automatic cleanup acts only
# when the registry and the CT's own metadata agree, so a CT that merely looks like a box is never touched.
reg_file() { echo "$BOX_VAR/registry/$1"; }
reg_write() { mkdir -p "$BOX_VAR/registry"; printf 'owner=%s created=%s\n' "$2" "$3" >"$(reg_file "$1")"; }
registered() {
  local f c
  f=$(reg_file "$1"); [ -f "$f" ] || return 1
  c=$(desc_field "$1" created)
  [ -n "$c" ] && grep -q " created=$c\$" "$f" && grep -q 'box1' <<<"$(top_conf "$1")"
}
snap_count() { pct listsnapshot "$1" 2>/dev/null | awk 'NF && $2 != "current"' | wc -l | tr -d ' '; }
expires_of() { top_conf "$1" | sed -n 's/.*expires_\([0-9][0-9]*\).*/\1/p' | sed -n 1p; }
desc_field() { top_conf "$1" | sed -n "s/.*$2_\([A-Za-z0-9._-]*\).*/\1/p" | sed -n 1p; }
fmt_rem() {
  local d=$(( $1 - $(now) ))
  if [ "$d" -le 0 ]; then echo expired
  elif [ "$d" -ge 3600 ]; then echo "$((d/3600))h$(( (d%3600)/60 ))m"
  else echo "$((d/60))m"; fi
}
ct_ip() {
  pct exec "$1" -- ip -4 -o addr show dev eth0 scope global </dev/null 2>/dev/null \
    | awk '{print $4}' | cut -d/ -f1 | sed -n 1p
}

# Wait until the CT answers pct exec AND eth0 has a DHCP address; then wait (best effort) for sshd.
wait_ready() {
  local id=$1 t=${2:-90} i ip=""
  for ((i=0; i<t; i++)); do
    if pct exec "$id" -- true </dev/null >/dev/null 2>&1; then
      ip=$(ct_ip "$id" || true)
      [ -n "$ip" ] && break
    fi
    sleep 1
  done
  [ -n "$ip" ] || die "CT $id did not get an IPv4 address within ${t}s (still running; inspect or 'box kill')"
  for i in $(seq 1 20); do
    if timeout 2 bash -c "exec 3<>/dev/tcp/$ip/22" 2>/dev/null; then break; fi
    sleep 1
  done
  echo "$ip"
}

count_running() {
  local n=0 id
  for id in $(list_ids); do [ "$(status_of "$id")" = running ] && n=$((n+1)); done
  echo "$n"
}
guard_resources() {
  local need=$1 avail swapfree running used
  if [ "${BOX_FORCE:-0}" = 1 ]; then log "BOX_FORCE=1: resource guards skipped"; return 0; fi
  avail=$(awk '/^MemAvailable:/{print int($2/1024)}' /proc/meminfo)
  swapfree=$(awk '/^SwapFree:/{print int($2/1024)}' /proc/meminfo)
  running=$(count_running)
  used=$(pvesm status --storage "$STORAGE" | awk 'NR==2{gsub(/%/,"",$NF); print int($NF)}')
  log "host: MemAvailable=${avail}MB SwapFree=${swapfree}MB running_boxes=$running $STORAGE=${used}%"
  [ "$running" -lt "$MAX_RUNNING" ] || die "already $running running boxes (MAX_RUNNING=$MAX_RUNNING); stop one first"
  [ "$avail" -ge $((need + MIN_FREE_MB)) ] || die "host MemAvailable ${avail}MB < need ${need}MB + headroom ${MIN_FREE_MB}MB (override: BOX_FORCE=1)"
  [ "$swapfree" -ge "$MIN_SWAP_FREE_MB" ] || die "host SwapFree ${swapfree}MB < ${MIN_SWAP_FREE_MB}MB; host is thrashing-prone (override: BOX_FORCE=1)"
  [ "$used" -lt "$MAX_STORAGE_PCT" ] || die "$STORAGE is ${used}% full (limit ${MAX_STORAGE_PCT}%)"
}

# Keep ephemeral IDs out of every all-guest backup job. add|remove <id> | prune
backup_exclude() {
  local op=$1 id=${2:-} jobs jid list
  jobs=$(pvesh get /cluster/backup --output-format json 2>/dev/null) || { log "warn: cannot read backup jobs"; return 0; }
  while IFS=$'\t' read -r jid list; do
    [ -n "$jid" ] || continue
    if [ -n "$list" ]; then pvesh set "/cluster/backup/$jid" --exclude "$list" >/dev/null
    else pvesh set "/cluster/backup/$jid" --delete exclude >/dev/null; fi
    log "backup job $jid exclude -> ${list:-<none>}"
  done < <(printf '%s' "$jobs" | perl -MJSON::PP -e '
    local $/; my $jobs = JSON::PP::decode_json(<STDIN>);
    my ($op, $id, $min, $max, @have) = @ARGV; my %have = map { $_ => 1 } @have;
    for my $j (@$jobs) {
      next unless $j->{all};
      my @old = grep { length } split(/,/, ($j->{exclude} // ""));
      my %e = map { $_ => 1 } @old;
      if ($op eq "add") { $e{$id} = 1 }
      elsif ($op eq "remove") { delete $e{$id} }
      elsif ($op eq "prune") { for my $k (keys %e) { delete $e{$k} if $k >= $min && $k <= $max && !$have{$k} } }
      my $new = join(",", sort { $a <=> $b } keys %e);
      my $was = join(",", sort { $a <=> $b } @old);
      print "$j->{id}\t$new\n" if $new ne $was;
    }' "$op" "$id" "$ID_MIN" "$ID_MAX" $(list_ids))
}

# set_desc <id> <owner> <expires> <name> <ttl> <created> [req]
set_desc() { pct set "$1" --description "box1 owner_$2 expires_$3 name_$4 ttl_$5 created_$6${7:+ req_$7}" >/dev/null; }

find_req() {
  local id
  for id in $(list_ids); do
    if [ "$(desc_field "$id" req)" = "$1" ]; then echo "$id"; return 0; fi
  done
  return 1
}

NEW_ID=""
r_new_cleanup() {
  trap - ERR
  [ -n "${NEW_ID:-}" ] || return 0
  log "failed; destroying half-built CT $NEW_ID"
  pct stop "$NEW_ID" >/dev/null 2>&1 || true
  pct destroy "$NEW_ID" --purge --destroy-unreferenced-disks 1 >/dev/null 2>&1 || true
  backup_exclude remove "$NEW_ID" || true
  rm -f "$(reg_file "$NEW_ID")"
}

# r_new <name> <cores> <mem> <disk> <ttl> <owner> <gpu> <req>
# A dropped client connection must not kill a creation half way: ignore HUP/PIPE and keep stderr alive.
# The client reconciles by <req> (see r_reconcile) instead of ever repeating the creation.
r_new() {
  local name=$1 cores=$2 mem=$3 disk=$4 ttl=$5 owner=$6 gpu=$7 req=${8:-} id="" i hn exp cur ip created
  local clone_args=(--full 0)
  trap '' HUP PIPE
  exec 2> >(while IFS= read -r l; do printf '%s\n' "$l" >&2 2>/dev/null || :; done)
  [ -f "$(conf_of "$GOLDEN_CTID")" ] || die "golden CT $GOLDEN_CTID missing; run: box golden build"
  grep -q '^template: 1' <<<"$(top_conf "$GOLDEN_CTID")" || die "CT $GOLDEN_CTID is not a template"
  [ "$FULL_CLONE" = 1 ] && clone_args=(--full 1 --storage "$STORAGE")
  if [ "$gpu" = 1 ]; then [ -e /dev/dri/renderD128 ] || die "/dev/dri/renderD128 missing on host"; fi

  mkdir -p "$LOCK_DIR"
  exec 9>"$LOCK_DIR/box.lock"
  flock -w 120 9 || die "could not take box lock"
  if [ -n "$req" ] && id=$(find_req "$req"); then
    log "request $req already created CT $id"; exec 9>&-
    echo "$id $(wait_ready "$id")"; return 0
  fi
  id=""
  guard_resources "$mem"
  for ((i=ID_MIN; i<=ID_MAX; i++)); do
    if ! compgen -G "$PVE_ETC/nodes/*/lxc/$i.conf" >/dev/null \
       && ! compgen -G "$PVE_ETC/nodes/*/qemu-server/$i.conf" >/dev/null \
       && pvesh get /cluster/nextid --vmid "$i" >/dev/null 2>&1; then id=$i; break; fi
  done
  [ -n "$id" ] || die "no free ID in $ID_MIN-$ID_MAX (run 'box gc')"
  hn=${name:-box-$id}
  created=$(now); exp=$(( created + ttl ))

  # Exclude the id from all-guest backup jobs before the CT exists, so no job can ever see it.
  NEW_ID=$id
  trap r_new_cleanup ERR
  backup_exclude add "$id"
  rm -f "$(reg_file "$id")"   # a stale record from a reused id must never vouch for a new CT
  pct clone "$GOLDEN_CTID" "$id" --hostname "$hn" "${clone_args[@]}" >&2
  pct set "$id" --tags box --onboot 0 --swap 0 --cores "$cores" --memory "$mem" \
    --net0 "name=eth0,bridge=$BRIDGE,ip=dhcp,firewall=0,type=veth" >&2
  set_desc "$id" "$owner" "$exp" "$hn" "$ttl" "$created" "$req"
  reg_write "$id" "$owner" "$created"
  cur=$(top_conf "$id" | sed -n 's/^rootfs:.*size=\([0-9]*\)G.*/\1/p')
  if [ -n "$cur" ] && [ "$disk" -gt "$cur" ]; then pct resize "$id" rootfs "${disk}G" >&2
  elif [ -n "$cur" ] && [ "$disk" -lt "$cur" ]; then log "note: golden rootfs is ${cur}G; cannot shrink to ${disk}G"; fi
  if [ "$gpu" = 1 ]; then pct set "$id" --dev0 /dev/dri/renderD128,mode=0666 >&2; fi
  pct start "$id" >&2
  exec 9>&-
  trap - ERR
  NEW_ID=""
  ip=$(wait_ready "$id")
  echo "$id $ip"
}

# Where did request <req> get to? Prints one of: none | building | ready <id> <ip> | partial <id>
r_reconcile() {
  local id ip
  mkdir -p "$LOCK_DIR"
  if id=$(find_req "$1"); then
    if [ "$(status_of "$id")" = running ] && ip=$(ct_ip "$id") && [ -n "$ip" ]; then echo "ready $id $ip"; return 0; fi
    exec 9>"$LOCK_DIR/box.lock"
    if flock -n 9; then echo "partial $id"; else echo "building"; fi
    return 0
  fi
  exec 9>"$LOCK_DIR/box.lock"
  if flock -n 9; then echo none; else echo building; fi
}

# Set a box's lease to at least <seconds> from now. mode=auto caps at created+MAX_LIFETIME and leaves
# legacy boxes (no lease metadata) alone; mode=force (explicit user request) adopts legacy boxes.
lease_extend() {
  local id=$1 secs=$2 mode=$3 ttl created exp new owner name
  ttl=$(desc_field "$id" ttl); created=$(desc_field "$id" created)
  owner=$(desc_field "$id" owner); name=$(desc_field "$id" name)
  if [ -z "$ttl" ] || [ -z "$created" ]; then
    [ "$mode" = force ] || return 0
    ttl=$secs; created=$(now)
  fi
  exp=$(expires_of "$id" || true)
  new=$(( $(now) + secs ))
  if [ "$mode" = auto ] && [ "$new" -gt $((created + MAX_LIFETIME_S)) ]; then new=$((created + MAX_LIFETIME_S)); fi
  [ "$new" -gt "${exp:-0}" ] || return 0
  set_desc "$id" "${owner:-unknown}" "$new" "${name:-box-$id}" "$ttl" "$created" "$(desc_field "$id" req)"
  [ -f "$(reg_file "$id")" ] || reg_write "$id" "${owner:-unknown}" "$created"
}

# Activity renewal. Silent and best effort: a busy or legacy box is simply left alone.
renew_quiet() {
  local id=$1 ttl
  [ "${LEASE_RENEW:-1}" = 1 ] || return 0
  ttl=$(desc_field "$id" ttl)
  [ -n "$ttl" ] || return 0
  if lock_id "$id" 2; then lease_extend "$id" "$ttl" auto || true; unlock_id; fi
  return 0
}
r_renew() { guard "$1"; renew_quiet "$1"; }
# Explicit: box extend / box job run. Honours the request, adopts legacy boxes.
r_extend() {
  guard "$1"
  lock_id "$1" 60 || die "CT $1 is busy"
  lease_extend "$1" "$2" force
  unlock_id
  echo "$1 expires in $(fmt_rem "$(expires_of "$1")")"
}
# Adopt legacy boxes (created before leases existed) so cleanup may manage them.
r_adopt() {
  local id=$1 ttl=$2 ids
  if [ "$id" = all ]; then ids=$(list_ids); else guard "$id"; ids=$id; fi
  for id in $ids; do
    if [ -n "$(desc_field "$id" ttl)" ] && registered "$id"; then echo "$id: already managed"; continue; fi
    lock_id "$id" 60 || { echo "$id: busy"; continue; }
    lease_extend "$id" "$ttl" force
    echo "$id: adopted (lease ${ttl}s, expires in $(fmt_rem "$(expires_of "$id")"))"
    unlock_id
  done
}

r_lease() {
  guard "$1"
  echo "id=$1 expires=$(expires_of "$1" || true) ttl=$(desc_field "$1" ttl) created=$(desc_field "$1" created) registered=$(registered "$1" && echo yes || echo no) tmux=$(pct exec "$1" -- sh -c 'command -v tmux >/dev/null && echo yes || echo no' </dev/null 2>/dev/null || echo unknown)"
}

r_resume() {
  local id=$1 ttl=$2 mem owner name ip created reqid
  guard "$id"
  lock_id "$id" 120 || die "CT $id is busy"
  guard "$id"
  mem=$(top_conf "$id" | sed -n 's/^memory: *//p')
  owner=$(desc_field "$id" owner); name=$(desc_field "$id" name)
  created=$(desc_field "$id" created); [ -n "$created" ] || created=$(now)
  reqid=$(desc_field "$id" req)
  # Renew the lease BEFORE starting: from here on cleanup (which takes the same lock) sees a live lease.
  set_desc "$id" "${owner:-unknown}" "$(( $(now) + ttl ))" "${name:-box-$id}" "$ttl" "$created" "$reqid"
  [ -f "$(reg_file "$id")" ] || reg_write "$id" "${owner:-unknown}" "$created"
  if [ "$(status_of "$id")" != running ]; then
    exec 9>"$LOCK_DIR/box.lock"; flock -w 120 9
    guard_resources "${mem:-1024}"
    pct start "$id" >&2
    exec 9>&-
  fi
  unlock_id
  ip=$(wait_ready "$id")
  echo "$id $ip"
}

stop_ct() { if [ "$(status_of "$1")" = running ]; then pct shutdown "$1" --timeout 30 >&2 || pct stop "$1" >&2; fi; }
kill_ct() {
  if [ "$(status_of "$1")" = running ]; then pct stop "$1" >&2; fi
  pct destroy "$1" --purge --destroy-unreferenced-disks 1 >&2
  backup_exclude remove "$1"
  rm -f "$(reg_file "$1")"
}
r_stop() { guard "$1"; lock_id "$1" 120 || die "CT $1 is busy"; stop_ct "$1"; unlock_id; }
r_kill() { guard "$1"; lock_id "$1" 120 || die "CT $1 is busy"; kill_ct "$1"; unlock_id; }

r_ip() { guard "$1"; [ "$(status_of "$1")" = running ] || die "CT $1 is not running"; renew_quiet "$1"; ct_ip "$1"; }
r_guard() { guard "$1"; }
r_touch() { guard "$1"; renew_quiet "$1"; }

r_list() {
  local id st ip exp rem cores mem name
  printf '%-6s %-18s %-8s %-15s %-9s %-5s %-6s %s\n' ID NAME STATUS IP EXPIRES CORES MEM OWNER
  for id in $(list_ids); do
    st=$(status_of "$id"); ip="-"
    [ "$st" = running ] && ip=$(ct_ip "$id" || true)
    exp=$(expires_of "$id" || true); rem="-"; [ -n "$exp" ] && rem=$(fmt_rem "$exp")
    cores=$(top_conf "$id" | sed -n 's/^cores: *//p'); mem=$(top_conf "$id" | sed -n 's/^memory: *//p')
    name=$(top_conf "$id" | sed -n 's/^hostname: *//p')
    printf '%-6s %-18s %-8s %-15s %-9s %-5s %-6s %s\n' "$id" "$name" "$st" "${ip:--}" "$rem" "${cores:-?}" "${mem:-?}" "$(desc_field "$id" owner)"
  done
  echo "# host: MemAvailable=$(awk '/^MemAvailable:/{print int($2/1024)}' /proc/meminfo)MB SwapFree=$(awk '/^SwapFree:/{print int($2/1024)}' /proc/meminfo)MB" >&2
}

# Act on one expired box, but only after taking its lock and re-checking everything under it:
# still a box, still expired (a renewal or resume since the scan wins), and for automatic runs
# (require_reg=1) registered, with no snapshots in the way of a destroy.
# reap_one <id> stop|destroy <grace-seconds> <require_reg>
reap_one() {
  local id=$1 action=$2 grace=$3 reqreg=$4 exp
  lock_id "$id" 0 || { echo "busy $id: left alone"; return 0; }
  if ! is_box "$id"; then echo "skip $id: no longer a box"; unlock_id; return 0; fi
  exp=$(expires_of "$id" || true)
  if [ -z "$exp" ] || [ "$(now)" -le $((exp + grace)) ]; then echo "skip $id: lease renewed"; unlock_id; return 0; fi
  if [ "$reqreg" = 1 ] && ! registered "$id"; then
    echo "skip $id: not in the registry (legacy box; 'box adopt $id' to let cleanup manage it)"; unlock_id; return 0
  fi
  case "$action" in
    stop)
      if [ "$(status_of "$id")" = running ]; then echo "stopping expired $id"; stop_ct "$id"; fi ;;
    destroy)
      if [ "$reqreg" = 1 ] && [ "$(snap_count "$id")" -gt 0 ]; then
        echo "hold $id: has snapshots; destroy it by hand with 'box kill $id' if intended"
      else echo "destroying expired $id"; kill_ct "$id"; fi ;;
  esac
  unlock_id
}

# Manual 'box gc'. mode: list (dry run) | stop | destroy
r_gc() {
  local mode=$1 id exp st n=0
  for id in $(list_ids); do
    exp=$(expires_of "$id" || true)
    [ -n "$exp" ] && [ "$exp" -lt "$(now)" ] || continue
    st=$(status_of "$id"); n=$((n+1))
    case "$mode" in
      list) echo "expired: $id ($st)" ;;
      stop|destroy) reap_one "$id" "$mode" 0 0 ;;
    esac
  done
  [ "$mode" = list ] || backup_exclude prune
  echo "expired boxes: $n"
}

# Unattended cleanup, run by the host's systemd timer.
# mode: report (default, only says what it would do) | stop | destroy (stop, then destroy later).
# Timeline per box: expires_at -> +GRACE: stop -> +DESTROY_AFTER: destroy. Snapshots hold a destroy.
r_cleanup() {
  local mode=${1:-} id exp st t action n=0 f rid
  if [ -z "$mode" ]; then mode=$(cat /etc/box/cleanup.mode 2>/dev/null || echo report); fi
  case "$mode" in report|stop|destroy) ;; *) die "cleanup: bad mode '$mode'";; esac
  mkdir -p "$BOX_VAR"
  t=$(now)
  echo "box cleanup mode=$mode at $(date -u +%FT%TZ) grace=${GRACE_S}s destroy_after=${DESTROY_AFTER_S}s"
  for id in $(list_ids); do
    exp=$(expires_of "$id" || true)
    [ -n "$exp" ] && [ "$t" -gt $((exp + GRACE_S)) ] || continue
    st=$(status_of "$id"); n=$((n+1))
    if [ "$st" = running ]; then action=stop
    elif [ "$t" -gt $((exp + DESTROY_AFTER_S)) ]; then action=destroy
    else action=wait; fi
    if [ "$mode" = report ] || [ "$action" = wait ] || { [ "$mode" = stop ] && [ "$action" = destroy ]; }; then
      echo "report $id ($st): expired $(( (t - exp) / 60 ))m ago, next step: $action$( registered "$id" || echo ' [unregistered: would be skipped]')"
    else
      reap_one "$id" "$action" "$GRACE_S" 1
    fi
  done
  # Registry entries whose CT no longer exists are stale; drop them (not while a creation is running).
  if [ -d "$BOX_VAR/registry" ] && [ "$mode" != report ]; then
    mkdir -p "$LOCK_DIR"; exec 9>"$LOCK_DIR/box.lock"
    if flock -n 9; then
      for f in "$BOX_VAR/registry"/*; do
        [ -e "$f" ] || continue; rid=${f##*/}
        is_box "$rid" || { echo "dropping stale registry entry $rid"; rm -f "$f"; }
      done
      backup_exclude prune
    fi
    exec 9>&-
  fi
  echo "expired boxes: $n"
}

# Install the cleanup helper + systemd timer on the PVE host. stdin = the helper script.
# r_install_host [mode]  (mode kept from the previous install when omitted; first install = report)
r_install_host() {
  local mode=${1:-}
  mkdir -p /etc/box /usr/local/sbin
  if [ -z "$mode" ]; then mode=$(cat /etc/box/cleanup.mode 2>/dev/null || echo report); fi
  case "$mode" in report|stop|destroy) ;; *) die "install: bad mode '$mode'";; esac
  cat >/usr/local/sbin/box-host.new
  chmod 700 /usr/local/sbin/box-host.new
  mv -f /usr/local/sbin/box-host.new /usr/local/sbin/box-host
  printf '%s\n' "$mode" >/etc/box/cleanup.mode
