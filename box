    --features nesting=1,keyctl=1 --cores 2 --memory 2048 --swap 0 --rootfs "$STORAGE:8" \
    --net0 "name=eth0,bridge=$BRIDGE,ip=dhcp,firewall=0,type=veth" \
    --ssh-public-keys "$keyf" --onboot 0 --tags boxgolden --description "box1 golden" >&2
