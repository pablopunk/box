# tui_ask <varname> <prompt> [default] : reads from /dev/tty so curl-piped runs work.
tui_ask() {
  local _var=$1 _prompt=$2 _def=${3:-} _ans
  if [ -n "$_def" ]; then
    printf '  %s [%s%s%s]: ' "$_prompt" "$C_DIM" "$_def" "$C_RST"
  else
    printf '  %s: ' "$_prompt"
  fi
  IFS= read -r _ans </dev/tty 2>/dev/null || _ans=""
  [ -n "$_ans" ] || _ans="$_def"
  printf -v "$_var" '%s' "$_ans"
}
# tui_yesno <prompt> [default Y|N] -> returns 0 for yes.
tui_yesno() {
  local _prompt=$1 _def=${2:-Y} _hint _ans
  if [ "$_def" = Y ]; then _hint="Y/n"; else _hint="y/N"; fi
  printf '  %s [%s]: ' "$_prompt" "$_hint"
  IFS= read -r _ans </dev/tty 2>/dev/null || _ans=""
  [ -n "$_ans" ] || _ans="$_def"
  [[ $_ans =~ ^[Yy] ]]
}
# with_spin <message> <cmd...> : runs cmd, shows spinner, replays stderr on failure.
# stdout passes through (so callers can capture it); only stderr is captured.
with_spin() {
  local msg=$1 out rc pid i=0 f
  shift
  out=$(mktemp)
  "$@" 2>"$out" & pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    case $((i % 4)) in 0) f='|';; 1) f='/';; 2) f='-';; 3) f='\';; esac
    printf '\r  %s %s' "$msg" "$f" >&2
    i=$((i+1))
    sleep 0.15
  done
  wait "$pid"; rc=$?
  printf '\r%*s\r' 40 "" >&2
  if [ "$rc" -ne 0 ]; then sed 's/^/  /' "$out" >&2; fi
  rm -f "$out"
  return "$rc"
}

# ---------------------------------------------------------------- commands
cmd_init() {
  local host="" key="" force=0 storage="" bridge="" golden="" tpl="" tui=0 alt=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --host) host=$2; shift 2;; --alt) alt=$2; shift 2;; --key) key=$2; shift 2;; --storage) storage=$2; shift 2;;
      --bridge) bridge=$2; shift 2;; --golden) golden=$2; shift 2;; --template) tpl=$2; shift 2;;
      --force) force=1; shift;; *) die "init: unknown option $1";;
    esac
  done
  # Interactive TUI when run on a terminal with nothing (or only --force) to do.
  if [ -t 0 ] || [ -c /dev/tty ]; then
    if [ -z "$host$alt$key$storage$bridge$golden$tpl" ]; then tui=1; fi
  fi
  if [ "$tui" = 0 ]; then cmd_init_plain "$host" "$key" "$force" "$storage" "$bridge" "$golden" "$tpl" "$alt"; return; fi

  tui_banner
  tui_step "1/4" "Where is your Proxmox?"
  tui_info "${C_DIM}user@host with SSH already configured (key auth, no password prompt).${C_RST}"
  tui_ask host "  Proxmox SSH" "${PVE_HOST:-}"
  [ -n "$host" ] || die "need a host"

  tui_step "2/4" "Which SSH key?"
  tui_info "${C_DIM}Its public key gets baked into every box for 'box ssh'.${C_RST}"
  tui_ask key "  Private key" "${SSH_KEY:-$HOME/.ssh/id_ed25519}"
  if [ ! -f "$key.pub" ]; then
    if [ ! -f "$key" ] && tui_yesno "  No key at $key. Generate one?" Y; then
      ssh-keygen -t ed25519 -f "$key" -N "" -C "box" || die "ssh-keygen failed"
    fi
    [ -f "$key.pub" ] || die "public key $key.pub not found"
  fi
  if ! ssh -o BatchMode=yes -o ConnectTimeout=10 "$host" true 2>/dev/null; then
    tui_warn "cannot ssh to $host non-interactively."
    if tui_yesno "  Copy your key over now (ssh-copy-id, asks for password once)?" Y; then
      ssh-copy-id -i "$key.pub" "$host" </dev/tty || die "ssh-copy-id failed"
      ssh -o BatchMode=yes -o ConnectTimeout=10 "$host" true || die "still cannot ssh to $host"
    else
      die "fix SSH first: ssh-copy-id -i $key.pub $host"
    fi
  fi
  tui_ok "SSH to $host works"
  PVE_HOST=$host
  alt=$(discover_alt "$host" "${PVE_HOST_ALT:-}")
  if [ -n "$alt" ]; then tui_ok "Tailscale fallback verified: $alt (same host key as $host)"
  else tui_info "${C_DIM}No Tailscale fallback (needs tailscale up on both machines). Add later: box init --alt root@<ts-ip> --force${C_RST}"; fi

  tui_step "3/4" "Confirm settings ${C_DIM}(Enter = default)${C_RST}"
  tui_ask storage "  Storage" "$STORAGE"
  tui_ask bridge "  Bridge" "$BRIDGE"
  tui_ask tpl "  LXC template volid" "$TEMPLATE_VOLID"
  tui_ask golden "  Golden CT id" "$GOLDEN_CTID"

  cmd_init_write "$host" "$key" "$storage" "$bridge" "$golden" "$tpl" "$alt"
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"

  tui_step "4/4" "Checking Proxmox (read-only)"
  local report
  report=$(mktemp)
  with_spin "probing $PVE_HOST" rcall check >"$report" || { cat "$report"; rm -f "$report"; die "checks failed"; }
  sed 's/^/  /' "$report"
  if grep -q '^template: MISSING' "$report"; then
    if tui_yesno "  Template missing. Download it now (a few minutes)?" Y; then
      with_spin "downloading template" rcall ensure_template "$TEMPLATE_VOLID" \
        || die "template download failed"
      tui_ok "template ready"
    else
      tui_warn "skipped — 'box new' will fail until the template exists"
    fi
  fi
  rm -f "$report"
  if ! rcall guard_golden >/dev/null 2>&1; then
    if tui_yesno "  No golden image. Build it now (apt run, ~5-10 min)?" Y; then
      cmd_golden build
    else
      tui_warn "skipped — run 'box golden build' later"
    fi
  else
    tui_ok "golden image present"
  fi
  printf '\n  %sAll set.%s Try: %sbox new --name demo%s then %sbox exec current -- uname -a%s\n' \
    "$C_OK" "$C_RST" "$C_B" "$C_RST" "$C_B" "$C_RST"
}

# Non-interactive init (flags or piped). Same as the original behaviour.
cmd_init_plain() {
  local host=$1 key=$2 force=$3 storage=$4 bridge=$5 golden=$6 tpl=$7 alt=${8:-}
  if [ -f "$CONFIG_FILE" ] && [ "$force" = 0 ]; then
    log "config exists ($CONFIG_FILE); re-running read-only checks. Use --force to rewrite."
  else
    [ -z "$alt" ] || { PVE_HOST=${host:-$PVE_HOST}; alt=$(discover_alt "$PVE_HOST" "$alt" 1); }
    cmd_init_write "${host:-${PVE_HOST:-}}" "$key" "$storage" "$bridge" "$golden" "$tpl" "$alt"
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
  fi
  [ -f "$SSH_KEY.pub" ] || die "public key $SSH_KEY.pub not found (set SSH_KEY in $CONFIG_FILE)"
  log "checking $PVE_HOST (read-only)..."
  ssh -o BatchMode=yes -o ConnectTimeout=10 "$PVE_HOST" true || die "cannot ssh to $PVE_HOST non-interactively (ssh-copy-id first)"
  if [ -z "$PVE_HOST_ALT" ]; then
    alt=$(discover_alt "$PVE_HOST" "" 2>/dev/null || true)
    [ -z "$alt" ] || log "tip: Tailscale fallback available; save it with: box init --force --host $PVE_HOST --alt $alt"
  fi
  rcall check
  log "next: box golden build   (creates CT $GOLDEN_CTID; only if 'golden: absent')"
}

# discover_alt <lan-host> [explicit-alt] [explicit-only]: print a verified Tailscale address for the same
# Proxmox host, or nothing. Candidate = the given alt, else the Tailscale IPv4 reported by the host itself.
# Verified = reachable over SSH and presenting the same host key as the LAN address.
discover_alt() {
  local lan=$1 cand=${2:-} only=${3:-0} user
  user=${lan%@*}; [ "$user" != "$lan" ] || user=root
  if [ -z "$cand" ] && [ "$only" = 0 ]; then
    cand=$(ssh -n -o BatchMode=yes -o ConnectTimeout=10 "$lan" 'command -v tailscale >/dev/null 2>&1 && tailscale ip -4 2>/dev/null | head -1' 2>/dev/null || true)
    [[ $cand =~ ^[0-9.]+$ ]] || cand=""
    [ -z "$cand" ] || cand="$user@$cand"
  fi
  [ -n "$cand" ] || return 0
  if ssh -n -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=8 "$cand" true >/dev/null 2>&1 && same_host_key "$lan" "$cand"; then
    printf '%s' "$cand"
  else
    log "Tailscale candidate $cand is unreachable or presents a different host key; not saved"
  fi
}

cmd_init_write() {
  local host=$1 key=$2 storage=$3 bridge=$4 golden=$5 tpl=$6 alt=${7:-}
  mkdir -p "$(dirname "$CONFIG_FILE")"
  cat >"$CONFIG_FILE" <<CFG
# box config (sourced as shell). Written by 'box init'.
PVE_HOST=${host:-${PVE_HOST:-}}
PVE_HOST_ALT=${alt:-${PVE_HOST_ALT:-}}
SSH_KEY=${key:-$SSH_KEY}
TEMPLATE_VOLID=${tpl:-$TEMPLATE_VOLID}
STORAGE=${storage:-$STORAGE}
BRIDGE=${bridge:-$BRIDGE}
GOLDEN_CTID=${golden:-$GOLDEN_CTID}
ID_MIN=$ID_MIN
ID_MAX=$ID_MAX
FULL_CLONE=$FULL_CLONE
DEFAULT_CORES=$DEFAULT_CORES
DEFAULT_MEM=$DEFAULT_MEM
DEFAULT_DISK=$DEFAULT_DISK
DEFAULT_TTL=$DEFAULT_TTL
MAX_RUNNING=$MAX_RUNNING
MIN_FREE_MB=$MIN_FREE_MB
MIN_SWAP_FREE_MB=$MIN_SWAP_FREE_MB
MAX_STORAGE_PCT=$MAX_STORAGE_PCT
OWNER=$OWNER
CONNECT_TIMEOUT=$CONNECT_TIMEOUT
IDLE_RENEW=$IDLE_RENEW
MAX_LIFETIME=$MAX_LIFETIME
GRACE=$GRACE
DESTROY_AFTER=$DESTROY_AFTER
RECONNECT_TRIES=$RECONNECT_TRIES
CFG
  chmod 600 "$CONFIG_FILE"
  log "wrote $CONFIG_FILE"
}

cmd_golden() {
  local arg=${1:-} force=0
  [ "$arg" = build ] || die "usage: box golden build [--force]"
  shift || true
  [ "${1:-}" = "--force" ] && force=1
  [ -f "$SSH_KEY.pub" ] || die "public key $SSH_KEY.pub not found"
  rcall golden_build "$(cat "$SSH_KEY.pub")" "$TEMPLATE_VOLID" "$force"
}

cmd_new() {
  local cores=$DEFAULT_CORES mem=$DEFAULT_MEM disk=$DEFAULT_DISK ttl=$DEFAULT_TTL name="" gpu=0 owner=$OWNER tools="" out id ip req rc
  while [ $# -gt 0 ]; do
    case "$1" in
      --cores) cores=$2; shift 2;; --mem) mem=$2; shift 2;; --disk) disk=${2%G}; shift 2;;
      --ttl) ttl=$2; shift 2;; --name) name=$2; shift 2;; --gpu) gpu=1; shift;; --owner) owner=$2; shift 2;;
      --tools) tools=$2; shift 2;;
      *) die "new: unknown option $1";;
    esac
  done
  [[ $cores =~ ^[0-9]+$ && $mem =~ ^[0-9]+$ && $disk =~ ^[0-9]+$ ]] || die "cores/mem/disk must be integers (mem in MB, disk in G)"
  [ -z "$name" ] || [[ $name =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || die "name must be lowercase [a-z0-9-]"
  owner=$(printf '%s' "$owner" | tr -c 'A-Za-z0-9._-' '-')
  [ -z "$tools" ] || [[ $tools =~ ^[A-Za-z0-9@._:/+\ -]+$ ]] || die "--tools: unexpected characters in '$tools'"
  req="$(date +%s)$RANDOM$RANDOM"
  rc=0; out=$(rcall new "$name" "$cores" "$mem" "$disk" "$(ttl_seconds "$ttl")" "$owner" "$gpu" "$req") || rc=$?
  if [ "$rc" -ne 0 ]; then
    [ "$rc" -eq 255 ] || exit "$rc"          # the host reported its own error: nothing to reconcile
    out=$(new_recover "$req") || exit $?
  fi
  read -r id ip <<<"$out"
  rm -f "$(known_hosts "$id")"                # a reused id must never inherit the old box's host key
  printf '%s' "$id" >"$STATE_DIR/current"
  [ -z "$tools" ] || install_tools "$id" "$tools"
  echo "$id $ip"
}

# The connection dropped while a creation was in flight. Never repeat the creation: ask the host what
# became of this request id. Prints "<id> <ip>" when it finished; otherwise says exactly what is left.
new_recover() {
  local req=$1 i st nones=0
  log "connection lost during creation; checking request $req on the host (will not create a second box)"
  for ((i=0; i<36; i++)); do
    PVE_ACTIVE=""
    if route_try && st=$(rcall reconcile "$req" 2>/dev/null); then
      case "$st" in
        ready*) log "creation finished on the host"; echo "${st#ready }"; return 0;;
        partial*) log "request created CT ${st#partial } but it is not running; inspect it: box list, box resume ${st#partial }, or box kill ${st#partial } -f"; return 3;;
        none) nones=$((nones+1))
              if [ "$nones" -ge 3 ]; then log "nothing was created for this request; it is safe to run 'box new' again"; return 4; fi;;
        *) nones=0;;
      esac
    fi
    sleep 5
  done
  log "host unreachable or still busy after 3 minutes; check 'box list' before retrying (request $req)"
  return 5
}

# Install runtimes with mise inside a box. Bootstraps mise when the golden image predates it.
install_tools() {
  local id=$1 tools=$2 script
  script=$(cat <<'EOS'
export LC_ALL=C.UTF-8
set -e
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
command -v mise >/dev/null || { curl -fsSL https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise sh; }
printf 'export PATH="$HOME/.local/share/mise/shims:/usr/local/bin:$PATH"\n' >/etc/profile.d/mise.sh
EOS
)
  script="$script"$'\n'"mise use -g --yes $tools"
  log "installing '$tools' with mise in CT $id"
  pve pct exec "$id" -- env LC_ALL=C.UTF-8 bash -lc "$script" >&2
}

# Keep the lease of a box alive while a long command or an attached session runs.
KEEPALIVE_PID=""
keepalive_start() {
  [ "$IDLE_RENEW" = 1 ] || return 0
  local id=$1
  # Detached from the caller's stdio (an inherited stdout would keep 'box exec | cmd' open until the next
  # tick) and it reaps its own sleep when stopped.
  (
    trap 'kill $(jobs -p) 2>/dev/null; exit 0' TERM
    while :; do
      sleep "${KEEPALIVE_INTERVAL:-300}" & wait $!
      PVE_ACTIVE=""; route_try && rcall renew "$id" >/dev/null 2>&1 || true
    done
  ) >/dev/null 2>&1 </dev/null &
  KEEPALIVE_PID=$!
}
keepalive_stop() {
  [ -z "$KEEPALIVE_PID" ] || { kill "$KEEPALIVE_PID" 2>/dev/null || true; wait "$KEEPALIVE_PID" 2>/dev/null || true; KEEPALIVE_PID=""; }
}

cmd_exec() {
  local id cmd rc=0
  id=$(resolve_id "${1:-current}"); shift || true
  [ "${1:-}" = -- ] && shift
  [ $# -gt 0 ] || die "usage: box exec <id|current> -- <cmd...>"
  rcall touch "$id"
  if [ $# -eq 1 ]; then cmd=$1; else cmd=$(printf '%q ' "$@"); fi
  keepalive_start "$id"
  pve pct exec "$id" -- env LC_ALL=C.UTF-8 bash -lc "$cmd" || rc=$?
  keepalive_stop
  return "$rc"
}

# Run on the box for interactive sessions: a tmux session that survives a dropped connection.
# tmux is installed on demand in boxes built from an older golden image; without it, a plain shell.
TMUX_ENSURE='command -v tmux >/dev/null 2>&1 || { echo "box: tmux missing in this box, installing..." >&2; DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tmux >/dev/null 2>&1 || true; }'

# A terminal the box has no terminfo for (ghostty, kitty, ...) makes tmux refuse to start: fall back.
TERM_FIX='infocmp "${TERM:-dumb}" >/dev/null 2>&1 || export TERM=xterm-256color'

# box ssh [id|current] [--plain] [-- cmd...]
# With no command on a terminal, attaches a persistent tmux session and, if the connection drops
# (network change, LAN <-> Tailscale, sleep), reconnects by itself and reattaches to the same session.
cmd_ssh() {
  local id=current plain=0 ip irc rc tries=0 remote t0
  if [ $# -gt 0 ] && [[ $1 =~ ^(current|[0-9]+)$ ]]; then id=$1; shift; fi
  id=$(resolve_id "$id")
  while [ $# -gt 0 ]; do
    case "$1" in --plain) plain=1; shift;; --) shift; break;; *) break;; esac
  done
  if [ $# -gt 0 ] || [ "$plain" = 1 ] || ! [ -t 0 ] || ! [ -t 1 ]; then
    ip=$(rcall ip "$id")
    ct_ssh_opts "$id"
    keepalive_start "$id"
    rc=0; ssh "${CT_OPTS[@]}" "root@$ip" "$@" || rc=$?
    keepalive_stop
    return "$rc"
  fi
  remote="$TERM_FIX; $TMUX_ENSURE; if command -v tmux >/dev/null 2>&1; then exec tmux new-session -A -s ${BOX_SESSION:-box}; else echo 'box: tmux unavailable; plain shell, no reconnect persistence' >&2; exec bash -l; fi"
  keepalive_start "$id"
  while :; do
    irc=0; ip=""
    if route_try; then ip=$(rcall ip "$id") || irc=$?; else irc=255; fi
    if [ "$irc" -eq 0 ]; then
      ct_ssh_opts "$id"
      t0=$SECONDS; rc=0; ssh -tt "${CT_OPTS[@]}" "root@$ip" "$remote" || rc=$?
      [ "$rc" -eq 255 ] || { keepalive_stop; return "$rc"; }
      # ssh also exits 255 when it never connected; only a session that lived a while earns a fresh budget
      if [ $((SECONDS - t0)) -ge 15 ]; then tries=0; fi
    elif [ "$irc" -ne 255 ]; then
      keepalive_stop; exit "$irc"   # the host answered and refused (box stopped, not a box...): stop, no retry
    fi
    tries=$((tries+1))
    if [ "$tries" -gt "$RECONNECT_TRIES" ]; then keepalive_stop; die "gave up reconnecting to box $id after $RECONNECT_TRIES attempts (the tmux session may still be alive: box ssh $id)"; fi
    log "connection to box $id lost; reconnecting ($tries/$RECONNECT_TRIES)..."
    sleep 2
    PVE_ACTIVE=""
  done
}

cmd_list() { rcall list; }

# ---- box doctor ---------------------------------------------------------------------------------
DOC_FAIL=0
doc_line() {  # doc_line <ok|warn|FAIL|info> <message>
  case "$1" in
    ok) printf '  %sok%s    %s\n' "$C_OK" "$C_RST" "$2";;
    warn) printf '  %swarn%s  %s\n' "$C_WARN" "$C_RST" "$2";;
    FAIL) DOC_FAIL=1; printf '  %sFAIL%s  %s\n' "$C_ERR" "$C_RST" "$2";;
    *) printf '  %s%s%s  %s\n' "$C_DIM" "$1" "$C_RST" "$2";;
  esac
}
doc_render() { local st msg; while IFS=$'\t' read -r st msg; do [ -z "$st" ] || doc_line "$st" "$msg"; done; }

# box doctor [--fix] [--e2e]
#   routes: LAN / Tailscale reachability and that both addresses are the same host
#   host:   required commands, storage, bridge, golden, cleanup timer, leases, tmux in boxes
#   backup: no box can land in a backup job (--fix adds missing exclusions)
#   --e2e:  create a throwaway box, ssh in, tmux session, lease, extend, destroy it
cmd_doctor() {
  local fix=0 e2e=0 a out rc lan=0 alt=0
  for a in "$@"; do case "$a" in --fix) fix=1;; --e2e) e2e=1;; *) die "doctor: unknown option $a";; esac; done
  [ -n "$PVE_HOST" ] || die "not configured; run: box init --host root@<pve-ip>"
  printf '%sroute%s\n' "$C_B" "$C_RST"
  if pve_probe "$PVE_HOST"; then lan=1; doc_line ok "LAN $PVE_HOST reachable"; else doc_line warn "LAN $PVE_HOST not reachable"; fi
  if [ -n "$PVE_HOST_ALT" ]; then
    if pve_probe "$PVE_HOST_ALT"; then
      alt=1; doc_line ok "alternate $PVE_HOST_ALT reachable"
      if same_host_key "$PVE_HOST" "$PVE_HOST_ALT"; then doc_line ok "both addresses present the same host key"
      elif [ "$lan" = 1 ]; then doc_line FAIL "$PVE_HOST and $PVE_HOST_ALT present DIFFERENT host keys: they are not the same machine"
      else doc_line info "cannot compare host keys while the LAN address is down"; fi
    else
      doc_line FAIL "alternate $PVE_HOST_ALT not reachable (Tailscale down, or the peer is offline: failover would not work right now)"
    fi
  else
    doc_line warn "no alternate address: a lost LAN connection cannot recover. Fix: box init --force --host $PVE_HOST --alt root@<tailscale-ip>"
  fi
  PVE_ACTIVE=""; rm -f "$STATE_DIR/route"   # report what a fresh command would pick, not the 30s sticky fallback
  if route_try; then doc_line ok "active route: $PVE_ACTIVE$([ "$PVE_ACTIVE" = "$PVE_HOST" ] && echo ' (LAN)' || echo ' (alternate)')"
  else doc_line FAIL "no route to Proxmox"; exit 1; fi

  printf '\n%shost%s\n' "$C_B" "$C_RST"
  rc=0; out=$(rcall hostcheck) || rc=$?
  [ "$rc" -eq 0 ] || doc_line FAIL "host checks failed to run (exit $rc)"
  doc_render <<<"$out"

  printf '\n%sbackups%s\n' "$C_B" "$C_RST"
  rc=0; out=$(rcall doctor "$fix") || rc=$?
  [ "$rc" -ne 255 ] || doc_line FAIL "backup checks failed to run"
  doc_render <<<"$out"

  if [ "$e2e" = 1 ]; then printf '\n%send to end%s\n' "$C_B" "$C_RST"; doctor_e2e; fi
  if [ "$DOC_FAIL" = 0 ]; then printf '\n  %sall good%s\n' "$C_OK" "$C_RST"; else printf '\n  %sproblems found%s\n' "$C_ERR" "$C_RST"; exit 1; fi
}

doctor_e2e() {
  local cur out id ip lease exp1 exp2 rc=0
  cur=$(cat "$STATE_DIR/current" 2>/dev/null || true)
  out=$(cmd_new --name "doctor-$RANDOM" --ttl 15m --disk 4 --owner doctor 2>/dev/null) || { doc_line FAIL "could not create a test box"; return; }
  read -r id ip <<<"$out"
  doc_line ok "created test box $id ($ip)"
  # always remove the test box, whatever happens below
  ct_ssh_opts "$id"
  if ssh "${CT_OPTS[@]}" -o BatchMode=yes "root@$ip" true 2>/dev/null; then doc_line ok "ssh to the box through the active route"; else doc_line FAIL "ssh to the box failed"; fi
  if pve pct exec "$id" -- bash -lc 'tmux new-session -d -s doctor "sleep 60" && tmux has-session -t doctor && tmux kill-session -t doctor' >/dev/null 2>&1; then
    doc_line ok "tmux session starts inside the box"
  else doc_line FAIL "tmux does not work in the box (rebuild the golden: box golden build --force)"; fi
  lease=$(rcall lease "$id" 2>/dev/null || true)
  if grep -q 'registered=yes' <<<"$lease" && grep -Eq 'ttl=[0-9]+' <<<"$lease"; then doc_line ok "lease and registry entry recorded"; else doc_line FAIL "lease/registry missing: $lease"; fi
  exp1=$(sed -n 's/.*expires=\([0-9]*\).*/\1/p' <<<"$lease")
  rcall extend "$id" 3600 >/dev/null 2>&1 || true
  exp2=$(rcall lease "$id" 2>/dev/null | sed -n 's/.*expires=\([0-9]*\).*/\1/p')
  if [ -n "$exp1" ] && [ -n "$exp2" ] && [ "$exp2" -gt "$exp1" ]; then doc_line ok "extend moves the expiry forward"; else doc_line FAIL "extend did not change the expiry ($exp1 -> $exp2)"; fi
  rcall kill "$id" >/dev/null 2>&1 || rc=1
  rm -f "$(known_hosts "$id")"
  if rcall guard "$id" >/dev/null 2>&1; then doc_line FAIL "test box $id still exists after kill"; else doc_line ok "test box destroyed"; fi
  if [ -n "$cur" ]; then printf '%s' "$cur" >"$STATE_DIR/current"; else rm -f "$STATE_DIR/current"; fi
}

# ---- leases, cleanup, jobs ------------------------------------------------------------------------
# box extend [id|current] <duration>: keep a box alive at least that long from now (also adopts legacy boxes).
cmd_extend() {
  local id=current dur
  if [ $# -ge 2 ]; then id=$1; shift; fi
  dur=${1:?usage: box extend [id|current] <duration e.g. 2h>}
  rcall extend "$(resolve_id "$id")" "$(ttl_seconds "$dur")"
}

# box adopt <id|all> [--ttl 1h]: give boxes that predate leases a lease and a registry entry, so
# unattended cleanup may manage them. Their current expiry is kept.
cmd_adopt() {
  local id=${1:?usage: box adopt <id|all> [--ttl 1h]} ttl=$DEFAULT_TTL
  shift
  [ "${1:-}" != --ttl ] || ttl=${2:?--ttl needs a value}
  [ "$id" = all ] || id=$(resolve_id "$id")
  rcall adopt "$id" "$(ttl_seconds "$ttl")"
}

# box cleanup install|status|preview|run|mode
cmd_cleanup() {
  local sub=${1:-status} mode="" yes=0 a
  shift || true
  confirm_destroy() {
    [ "$yes" = 1 ] && return 0
    [ -t 0 ] && [ -c /dev/tty ] || die "mode destroy deletes expired boxes unattended; pass --yes to confirm"
    printf '  destroy mode: the host will DELETE boxes %s after they expire (stopped first after %s). Type "destroy" to confirm: ' "$DESTROY_AFTER" "$GRACE"
    IFS= read -r a </dev/tty; [ "$a" = destroy ] || die "aborted"
  }
  case "$sub" in
    install)
      while [ $# -gt 0 ]; do case "$1" in --mode) mode=$2; shift 2;; --yes) yes=1; shift;; *) die "cleanup install: unknown option $1";; esac; done
      case "$mode" in ""|report|stop|destroy) ;; *) die "mode is report, stop or destroy";; esac
      [ "$mode" != destroy ] || confirm_destroy
      { echo '#!/usr/bin/env bash'; remote_env; printf '%s\n' "$REMOTE_LIB"; } | rcall_in install_host "$mode"
      log "the host now runs 'box cleanup' every 5 minutes; check what it would do with: box cleanup preview" ;;
    status) rcall cleanup_status ;;
    preview) rcall cleanup report ;;
    run) rcall cleanup ;;
    mode)
      mode=${1:?usage: box cleanup mode report|stop|destroy [--yes]}; shift
      [ "${1:-}" != --yes ] || yes=1
      [ "$mode" != destroy ] || confirm_destroy
      rcall set_cleanup_mode "$mode" ;;
    *) die "usage: box cleanup install [--mode report|stop|destroy] | status | preview | run | mode <m>" ;;
  esac
}

# box job run|ls|log|stop: detached work inside a box (tmux), with log, exit status and an explicit lease.
# The box's lease is extended to cover --lease (default 2h) and is NOT renewed by the job merely existing.
cmd_job() {
  local sub=${1:-ls} id=current lease=2h cmd="" jid follow=0
  shift || true
  if [ $# -gt 0 ] && [[ $1 =~ ^(current|[0-9]{1,6})$ ]]; then id=$1; shift; fi
  id=$(resolve_id "$id")
  case "$sub" in
    run)
      while [ $# -gt 0 ]; do case "$1" in --lease) lease=$2; shift 2;; --) shift; break;; *) break;; esac; done
      [ $# -gt 0 ] || die "usage: box job run [id|current] [--lease 2h] -- <cmd...>"
      if [ $# -eq 1 ]; then cmd=$1; else cmd=$(printf '%q ' "$@"); fi
      rcall extend "$id" "$(ttl_seconds "$lease")" >&2
      jid="$(date +%s)$RANDOM"
      printf '%s\n' "$cmd" | pve pct exec "$id" -- bash -c "mkdir -p /var/log/box-jobs && cat > /var/log/box-jobs/$jid.sh"
      pve pct exec "$id" -- env LC_ALL=C.UTF-8 bash -lc "$TMUX_ENSURE; command -v tmux >/dev/null || { echo 'box: no tmux in this box' >&2; exit 3; }; tmux new-session -d -s job-$jid 'bash -l /var/log/box-jobs/$jid.sh >/var/log/box-jobs/$jid.log 2>&1; echo \$? >/var/log/box-jobs/$jid.exit'" \
        || die "could not start the job"
      echo "$jid"
      log "job $jid running in box $id; box job log $id $jid -f | box job ls $id | box job stop $id $jid" ;;
    ls)
      pve pct exec "$id" -- bash -c 'for f in /var/log/box-jobs/*.sh; do [ -e "$f" ] || continue; j=$(basename "$f" .sh); if tmux has-session -t "job-$j" 2>/dev/null; then st=running; elif [ -f "/var/log/box-jobs/$j.exit" ]; then st="exit $(cat /var/log/box-jobs/$j.exit)"; else st=lost; fi; printf "%s  %-9s %s\n" "$j" "$st" "$(head -1 "$f" | cut -c1-60)"; done' ;;
    log)
      jid=${1:?usage: box job log [id|current] <jobid> [-f]}; shift
      [ "${1:-}" != -f ] || follow=1
      [[ $jid =~ ^[0-9]+$ ]] || die "bad job id"
      if [ "$follow" = 1 ]; then pve pct exec "$id" -- tail -n +1 -f "/var/log/box-jobs/$jid.log"; else pve pct exec "$id" -- cat "/var/log/box-jobs/$jid.log"; fi ;;
    stop)
      jid=${1:?usage: box job stop [id|current] <jobid>}
      [[ $jid =~ ^[0-9]+$ ]] || die "bad job id"
      pve pct exec "$id" -- tmux kill-session -t "job-$jid" ;;
    *) die "usage: box job run|ls|log|stop" ;;
  esac
}

cmd_stop() { rcall stop "$(resolve_id "${1:-current}")"; }

cmd_resume() {
  local id ttl=$DEFAULT_TTL out ip
  id=$(resolve_id "${1:-current}"); shift || true
  [ "${1:-}" = --ttl ] && ttl=${2:?--ttl needs a value}
  out=$(rcall resume "$id" "$(ttl_seconds "$ttl")")
  read -r id ip <<<"$out"
  printf '%s' "$id" >"$STATE_DIR/current"
  echo "$id $ip"
}

cmd_kill() {
  local id force=0 a
  id=$(resolve_id "${1:-current}"); shift || true
  for a in "$@"; do case "$a" in -f|--force|--yes) force=1;; *) die "kill: unknown option $a";; esac; done
  rcall guard "$id"
  if [ "$force" = 0 ]; then
    [ -t 0 ] && [ -c /dev/tty ] || die "kill in scripts needs -f (destroys CT $id and its disk)"
    printf 'destroy CT %s and its disk? type the id to confirm (or use -f): ' "$id"
    IFS= read -r a </dev/tty
    [ "$a" = "$id" ] || die "aborted"
  fi
  rcall kill "$id"
  rm -f "$(known_hosts "$id")"
  if [ -s "$STATE_DIR/current" ] && [ "$(cat "$STATE_DIR/current")" = "$id" ]; then rm -f "$STATE_DIR/current"; fi
  log "destroyed $id"
}

cmd_shot() {
  local id out tmp
  id=$(resolve_id "${1:-current}"); shift || true
  out=${1:-./box-$id-$(date +%Y%m%d-%H%M%S).png}
  tmp=$(mktemp)
  rcall shot "$id" >"$tmp" || { rm -f "$tmp"; die "screenshot failed"; }
  [ "$(head -c4 "$tmp" | tail -c3)" = PNG ] || { rm -f "$tmp"; die "result is not a PNG"; }
  mv "$tmp" "$out"; echo "$out"
}

# remote_spec <arg>: succeeds when arg is <id|current>:<path>; sets R_ID and R_PATH.
remote_spec() {
  [[ ${1:-} =~ ^(current|[0-9]+):(.*)$ ]] || return 1
  R_ID=${BASH_REMATCH[1]}; R_PATH=${BASH_REMATCH[2]}
}

# box cp [-r] <src> <dest>: copy files to or from a box. rsync when both sides have it, else scp.
# Trailing slash follows rsync: 'dir/' copies the contents, 'dir' copies the directory itself.
cmd_cp() {
  local recursive=0 a o args=() src dst id ip rpath direction target e flags=()
  export LC_ALL=C   # ssh forwards LC_*; a box without your locale prints setlocale warnings otherwise
  for a in "$@"; do case "$a" in -r|-R) recursive=1;; *) args+=("$a");; esac; done
  [ "${#args[@]}" -eq 2 ] || die "usage: box cp [-r] <src> <dest>   (one side is <id|current>:<path>)"
  src=${args[0]}; dst=${args[1]}
  if remote_spec "$src"; then
    ! remote_spec "$dst" || die "cp: copying between two boxes is not supported"
    direction=pull
    remote_spec "$src"
  elif remote_spec "$dst"; then
    direction=push
  else
    die "cp: one side must be <id|current>:<path>"
  fi
  id=$(resolve_id "$R_ID"); rpath=$R_PATH
  ip=$(rcall ip "$id")
  ct_ssh_opts "$id"
  target="root@$ip:$rpath"
  local ssh_opts=("${CT_OPTS[@]}" -o BatchMode=yes)
  if command -v rsync >/dev/null && ssh "${ssh_opts[@]}" "root@$ip" 'command -v rsync >/dev/null' 2>/dev/null; then
    e="ssh"; for o in "${ssh_opts[@]}"; do e+=" \"$o\""; done
    if [ "$direction" = push ]; then rsync -az --partial -e "$e" "$src" "$target"
    else rsync -az --partial -e "$e" "$target" "$dst"; fi
  else
    [ "$recursive" = 0 ] || flags=(-r)
    if [ "$direction" = push ]; then scp ${flags[@]+"${flags[@]}"} "${ssh_opts[@]}" "$src" "$target"
    else scp ${flags[@]+"${flags[@]}"} "${ssh_opts[@]}" "$target" "$dst"; fi
  fi
}

# box snap [id|current] <url> [out.png] [--size WxH] [--wait SEC]: headless Chromium screenshot of a URL.
# The browser runs in the box, so no window ever opens on your machine.
cmd_snap() {
  local id=current url out size=1280x800 wait=5 pos=() tmp
  while [ $# -gt 0 ]; do
    case "$1" in
      --size) size=$2; shift 2;; --wait) wait=$2; shift 2;;
      *) pos+=("$1"); shift;;
    esac
  done
  if [ "${#pos[@]}" -gt 0 ] && [[ ${pos[0]} =~ ^(current|[0-9]+)$ ]]; then id=${pos[0]}; pos=(${pos[@]+"${pos[@]:1}"}); fi
  [ "${#pos[@]}" -ge 1 ] || die "usage: box snap [id|current] <url> [out.png] [--size WxH] [--wait SEC]"
  url=${pos[0]}; out=${pos[1]:-}
  [[ $url =~ ^https?://[^[:space:]\'\"\\\`\$]+$ ]] || die "snap: url must be http(s), with no spaces or quotes"
  [[ $size =~ ^[0-9]+x[0-9]+$ ]] || die "snap: --size looks like 1280x800"
  [[ $wait =~ ^[0-9]+$ ]] || die "snap: --wait is whole seconds"
  id=$(resolve_id "$id")
  [ -n "$out" ] || out=./box-snap-$id-$(date +%Y%m%d-%H%M%S).png
  rcall touch "$id"
  pve pct exec "$id" -- env LC_ALL=C.UTF-8 bash -lc "B=\$(command -v chromium || command -v chromium-browser || command -v google-chrome) || { echo 'box: no chromium in this box (apt-get install -y chromium)' >&2; exit 3; }; rm -f /tmp/box-snap.png; timeout 120 \"\$B\" --headless=new --no-sandbox --disable-gpu --hide-scrollbars --window-size=${size/x/,} --virtual-time-budget=$((wait * 1000)) --screenshot=/tmp/box-snap.png '$url' >/dev/null 2>&1; test -s /tmp/box-snap.png" \
    || die "snap failed: chromium wrote no screenshot"
  tmp=$(mktemp)
  pve pct exec "$id" -- cat /tmp/box-snap.png >"$tmp" || { rm -f "$tmp"; die "could not read the screenshot"; }
  [ "$(head -c4 "$tmp" | tail -c3)" = PNG ] || { rm -f "$tmp"; die "result is not a PNG"; }
  mv "$tmp" "$out"; echo "$out"
}

cmd_gc() {
  local mode=list force=0 a
  for a in "$@"; do
    case "$a" in --expired) mode=stop;; --destroy) mode=destroy;; -f|--force|--yes) force=1;; *) die "gc: unknown option $a";; esac
  done
  if [ "$mode" = destroy ] && [ "$force" = 0 ]; then
    if [ -t 0 ] && [ -c /dev/tty ]; then
      printf 'destroy all expired boxes? type "yes" to confirm (or use -f): '
      IFS= read -r a </dev/tty
      [ "$a" = yes ] || die "aborted"
    else
      die "gc --destroy in scripts needs -f"
    fi
  fi
  rcall gc "$mode"
}

usage() {
  cat <<'USAGE'
box - Proxmox LXCs on demand for your agents (ephemeral Debian containers, use-and-destroy)

COMMANDS
  box init [flags]              one-time setup. On a TTY with no flags: guided TUI
                                (host, SSH key, checks, template download, golden build).
                                Flags: --host user@ip --key PATH --storage S --bridge B
                                --golden ID --template VOLID --force
  box golden build [--force]        build golden template CT (required once; --force rebuilds in place)
  box new [opts]                create + start a box -> prints "<id> <ip>"
                                --cores N --mem MB --disk G --ttl 1h --name slug --gpu --owner X
                                --tools "node@24 pnpm"  install runtimes with mise (node, pnpm, go, python...)
  box exec <id|current> -- <cmd...>   run command, print output (one arg = shell string)
                                stdin passes through: printf %s "$TOKEN" | box exec current -- 'umask 077; cat > /root/.token'
  box ssh  <id|current> [--plain] [-- cmd]
                                interactive shell = persistent tmux session. If the connection drops (network
                                change, LAN <-> Tailscale, laptop sleep) it reconnects by itself and reattaches.
                                --plain: ordinary ssh, no tmux, no reconnect. With a command: runs it, no tmux.
  box job run [id] [--lease 2h] -- <cmd>   detached job in the box (tmux) -> prints a job id; the box lease is
                                extended to cover --lease. box job ls|log <job> [-f]|stop <job> [id]
  box extend [id] <dur>         keep a box alive at least <dur> from now (also adopts legacy boxes)
  box adopt <id|all> [--ttl 1h] give boxes that predate leases a lease so unattended cleanup may manage them
  box cleanup install [--mode report|stop|destroy] [--yes]
                                install the host timer (every 5 min). Default and safe: report only.
                                box cleanup status | preview | run | mode <m>
  box cp [-r] <src> <dest>      copy files; one side is <id|current>:<path>. rsync (else scp) over the
                                PVE jump host. 'dir/' copies contents, 'dir' the directory itself
  box snap [id|current] <url> [out.png] [--size 1280x800] [--wait 5]
                                headless Chromium screenshot of a URL, run inside the box
  box list                      table of boxes: id, name, status, ip, ttl left, cores, mem, owner
  box stop <id|current>         stop (disk kept, TTL kept)
  box resume <id|current> [--ttl 1h]  start again + extend TTL -> prints "<id> <ip>"
  box kill <id|current> [-f]    DESTROY box and disk. Confirms on a TTY; -f required in scripts
  box shot <id|current> [out.png]     Xvfb :99 screenshot (starts display if needed)
  box doctor [--fix] [--e2e]    routes (LAN/Tailscale, same host key), host commands, golden, cleanup timer,
                                leases, tmux, backup exclusions; exit 1 on FAIL. --fix adds missing backup
                                exclusions. --e2e also creates, uses and destroys a throwaway box
  box gc [--expired]            stop expired boxes
  box gc --destroy [-f]         DESTROY expired boxes. Confirms on a TTY; -f required in scripts
  box help | -h                 this

SEMANTICS
  <id>              numeric CT id (e.g. 9101). "current" = last box you created/resumed.
  lease             boxes expire after TTL (default 1h) of inactivity: box exec/ssh/cp/snap/shot and
                    an attached 'box ssh' renew it (never past MAX_LIFETIME, default 7d, since creation).
                    resume --ttl / extend set it explicitly. Stored as expires_<epoch> in the CT notes.
  cleanup           'box gc' is manual. 'box cleanup install' adds a host timer that works while every
                    client is offline: expired + GRACE (10m) -> stop; +DESTROY_AFTER (24h) -> destroy.
                    Starts REPORT-ONLY. It only touches boxes whose host registry entry and CT metadata
                    agree (so boxes older than this feature need 'box adopt'), re-checks the lease under a
                    per-box lock right before acting, and never destroys a box that has snapshots.
  route             PVE_HOST is tried first; if it does not answer, PVE_HOST_ALT (Tailscale). Both share one
                    pinned host key (~/.box/known_hosts_pve): a mismatch is refused. LAN wins again as
                    soon as it answers. One-time setup: box init --alt root@<tailscale-ip> --force.
  safety            every command only touches ids 9101-9199 with PVE tag "box".
                    Anything else is refused. Truly destructive: kill, gc --destroy.
  guards            new/resume refuse when host RAM/swap is low, MAX_RUNNING boxes (default 6)
                    are running, or storage >=85%. Raise MAX_RUNNING in the config; the RAM guard
                    is the real limit. Override only with explicit human OK: BOX_FORCE=1.
  backups           box ids are excluded from all-guest backup jobs before the CT exists. PVE always
                    backs up a container's rootfs (backup=0 only works on extra mount points), so
                    exclusion is the guard. 'box doctor' verifies it.
  output            new/resume print "<id> <ip>"; exec/ssh stream command output.
  scripts/agents    no prompts except init TUI; pass -f to kill/gc --destroy.
                    Safe pattern: box new -> box exec current -- ... -> box kill current -f

CONFIG & STATE
  ~/.config/box/config   shell-sourced config (written by init): PVE_HOST PVE_HOST_ALT SSH_KEY STORAGE
                         BRIDGE TEMPLATE_VOLID GOLDEN_CTID ID_MIN ID_MAX defaults, guards, OWNER,
                         CONNECT_TIMEOUT IDLE_RENEW MAX_LIFETIME GRACE DESTROY_AFTER RECONNECT_TRIES
  ~/.box/                local state: "current" file, per-box known_hosts, ssh control socket
  env overrides          BOX_CONFIG BOX_STATE BOX_FORCE=1
USAGE
}

main() {
  local c=${1:-help}; shift || true
  case "$c" in init|help|-h|--help|doctor) ;; *) need_host ;; esac   # pick LAN or Tailscale once, up front
  case "$c" in
    init) cmd_init "$@";; golden) cmd_golden "$@";; new) cmd_new "$@";; exec) cmd_exec "$@";;
    ssh) cmd_ssh "$@";; doctor) cmd_doctor "$@";; extend) cmd_extend "$@";; adopt) cmd_adopt "$@";;
    cleanup) cmd_cleanup "$@";; job) cmd_job "$@";; list|ls) cmd_list;; stop) cmd_stop "$@";; resume) cmd_resume "$@";;
    kill|rm) cmd_kill "$@";; shot) cmd_shot "$@";; snap) cmd_snap "$@";; cp) cmd_cp "$@";; gc) cmd_gc "$@";;
    help|-h|--help) usage;; *) usage >&2; exit 2;;
  esac
}
# Sourceable for tests: only run when executed.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
