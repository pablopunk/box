Description=box: lease cleanup for ephemeral containers
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/box-host cleanup
UNIT
  cat >/etc/systemd/system/box-cleanup.timer <<'UNIT'
[Unit]
Description=box: run lease cleanup every 5 minutes
[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
Persistent=true
